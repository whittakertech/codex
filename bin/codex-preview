#!/usr/bin/env bash
#
# codex-preview — build + serve a hatchery preview of the unified Codex docs
# style, in one command.
#
#   bin/codex-preview <engine> <docs-path>
#   e.g. bin/codex-preview midas ~/apps/midas/docs
#
# Builds the engine's docs into astro/dist, then serves them via the nginx +
# Traefik stack at https://codex.hatchery.whittakertech.com -- named after
# Codex itself, not the engine, since this previews Codex's unified
# rendering style, not any one engine's own docs site. One build lives in
# astro/dist at a time -- re-run for a different engine (or run the driver
# directly with multiple --engine/--src pairs to ingest more than one at
# once) to change what's being previewed.
set -euo pipefail

ENGINE="${1:-}"
SRC="${2:-}"
if [[ -z "$ENGINE" || -z "$SRC" ]]; then
  echo "usage: bin/codex-preview <engine> <docs-path>" >&2
  echo "  e.g. bin/codex-preview midas ~/apps/midas/docs" >&2
  exit 1
fi

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"

# Activate the repo's pinned Node (asdf) — the global default may be `system`.
export ASDF_DATA_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}"
export PATH="$ASDF_DATA_DIR/bin:$ASDF_DATA_DIR/shims:$PATH"

# First-run dependency install for each layer.
[[ -d node_modules ]]       || npm install
[[ -d astro/node_modules ]] || npm install --prefix astro

# Build the static site for this engine.
npm run preview:build -- --engine "$ENGINE" --src "$SRC"

# Serve it. The bind-mounted dist means a rebuild needs no restart.
docker compose up -d

echo
echo "✓ Preview live: https://codex.hatchery.whittakertech.com"
