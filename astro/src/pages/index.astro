---
/**
 * Root landing page — lists the engines whose docs are mounted in _ingest/ and
 * links to each. A real (non-redirect) page so it has an <html> root and does
 * not break the sitemap integration. Per-engine deploys serve a single engine,
 * but the ecosystem build lists them all.
 */
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';

const ingestDir = join(process.cwd(), 'src', '_ingest');
const engines = existsSync(ingestDir)
  ? readdirSync(ingestDir, { withFileTypes: true })
      .filter((d) => d.isDirectory())
      .map((d) => d.name)
      .sort()
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WhittakerTech Docs</title>
  </head>
  <body>
    <main>
      <h1>WhittakerTech Documentation</h1>
      {
        engines.length === 0 ? (
          <p>No documentation has been published yet.</p>
        ) : (
          <ul>
            {engines.map((engine) => (
              <li>
                <a href={`/${engine}/`}>{engine}</a>
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
